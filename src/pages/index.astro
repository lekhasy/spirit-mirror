---
import Layout from '../layouts/Layout.astro';

const countries = [
  {
    name: 'Vietnam',
    native: 'Việt Nam',
    path: '/vietnam',
    image: 'https://images.unsplash.com/photo-1557750255-c76072a7aad1?q=80&w=2940&auto=format&fit=crop',
    tagline: '96M people · 4,000 years of history',
    description: 'Market flavors, river life, and a spirit forged through centuries of resilience.',
    accent: '#e8a020',
    bg: 'linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%)',
    pillars: ['History', 'Music', 'Belief', 'Festivals'],
    ready: true,
  },
  {
    name: 'Japan',
    native: '日本',
    path: '/japan',
    image: 'https://orizuruya.net/wp-content/uploads/2024/07/%E3%82%B9%E3%82%AF%E3%83%AA%E3%83%BC%E3%83%B3%E3%82%B7%E3%83%A7%E3%83%83%E3%83%88-2024-07-29-111659.png',
    tagline: '125M people · 2,600 years of tradition',
    description: 'Seasons, silence, and the beauty found in impermanence.',
    accent: '#bc002d',
    bg: 'linear-gradient(135deg, #fce4ec 0%, #f8bbd9 100%)',
    pillars: ['History', 'Music', 'Belief', 'Rituals'],
    ready: true,
  },
  {
    name: 'Brazil',
    native: 'Brasil',
    path: '/brazil',
    image: 'https://images.unsplash.com/photo-1700677866571-43199bcbc593?q=80&w=3430&auto=format&fit=crop',
    tagline: '215M people · 500 years of mixing',
    description: 'Rhythm, color, and a people who turn hardship into celebration.',
    accent: '#ffdf00',
    bg: 'linear-gradient(135deg, #e0f2f1 0%, #b2dfdb 100%)',
    pillars: ['Music', 'Festivals', 'Dance', 'Stories'],
    ready: true,
  },
  {
    name: 'Nigeria',
    native: 'Naìjíríà',
    path: '/nigeria',
    image: 'https://images.unsplash.com/photo-1618828665011-0abd973f7bb8?q=80&w=3432&auto=format&fit=crop',
    tagline: '220M people · 250+ ethnic groups',
    description: 'Bold textiles, griot storytelling, and the continent\'s creative heartbeat.',
    accent: '#008751',
    bg: 'linear-gradient(135deg, #e8f5e9 0%, #a5d6a7 100%)',
    pillars: ['Stories', 'Music', 'Belief', 'Rituals'],
    ready: true,
  },
  {
    name: 'India',
    native: 'भारत',
    path: '/india',
    image: 'https://images.unsplash.com/flagged/photo-1577604981316-298e453a19dd?q=80&w=2946&auto=format&fit=crop',
    tagline: '1.4B people · 5,000 years of civilization',
    description: 'A tapestry of languages, faiths, and festivals that defies easy description.',
    accent: '#ff9933',
    bg: 'linear-gradient(135deg, #fff3e0 0%, #ffe0b2 100%)',
    pillars: ['Belief', 'Festivals', 'Literature', 'Dance'],
    ready: true,
  },
  {
    name: 'United States',
    native: 'United States',
    path: '/united-states',
    image: 'https://images.unsplash.com/photo-1485738422979-f5c462d49f74?q=80&w=2940&auto=format&fit=crop',
    tagline: '335M people · A nation of immigrants',
    description: 'E pluribus unum. From many, one — a culture built on reinvention, dissent, and boundless ambition.',
    accent: '#3c3c6e',
    bg: 'linear-gradient(135deg, #e8eaf6 0%, #c5cae9 100%)',
    pillars: ['Stories', 'Music', 'Belief', 'Festivals'],
    ready: true,
  },
];

const themes = [
  { icon: '📜', label: 'History', desc: 'How the past shapes the present' },
  { icon: '👨‍👩‍👧', label: 'Parenting', desc: 'How children are raised' },
  { icon: '📖', label: 'Stories', desc: 'Myths, fables, and folk tales' },
  { icon: '🙏', label: 'Belief', desc: 'Faith, spirituality, and worldview' },
  { icon: '🪔', label: 'Rituals', desc: 'The ceremonies of life' },
  { icon: '🎆', label: 'Festivals', desc: 'Celebrations across the year' },
  { icon: '🎵', label: 'Music', desc: 'Sound and soul across time' },
  { icon: '✍️', label: 'Literature', desc: 'Words that carry a culture' },
  { icon: '💃', label: 'Dance', desc: 'Movement as expression' },
];
---

<Layout title="Spirit Mirror — Discover World Cultures">

<!-- Nav override -->
<style is:global>
  .site-root { display: flex; flex-direction: column; min-height: 100vh; }
  .site-header {
    background: rgba(255,255,255,0.92) !important;
    backdrop-filter: blur(12px) !important;
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    z-index: 200 !important;
    border-bottom: 1px solid rgba(0,80,0,0.1) !important;
    box-shadow: 0 1px 8px rgba(0,0,0,0.06) !important;
  }
  .site-logo { color: #1a5c2a !important; font-size: 1.1rem !important; font-weight: 700 !important; letter-spacing: 0.04em !important; }
</style>

<!-- ① HERO -->
<section class="hero">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-orb hero-orb-1"></div>
    <div class="hero-orb hero-orb-2"></div>
    <div class="hero-orb hero-orb-3"></div>
  </div>
  <div class="hero-inner">
    <h1 class="hero-h1">Every culture has <em>a story to tell.</em></h1>
    <p class="hero-sub">Explore the beliefs, rituals, music, and history that shape each culture.</p>
    <div class="search-container">
      <div class="search-wrap">
        <svg class="search-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="8.5" cy="8.5" r="6"/><line x1="13" y1="13" x2="18" y2="18"/></svg>
        <input type="text" id="country-search" class="search-input" placeholder="Search for a country..." autocomplete="off" />
        <button id="search-clear" class="search-clear" aria-label="Clear search">&times;</button>
      </div>
    </div>
  </div>
</section>

<!-- ② CULTURES STRIP -->
<section class="cultures-strip" id="countries">
  <div class="country-grid" id="country-grid">
    {countries.map((c) => (
      <a href={c.path} class={`country-card${c.ready ? '' : ' coming-soon'}`} style={`--card-accent: ${c.accent};`} data-name={c.name.toLowerCase()} data-native={c.native.toLowerCase()}>
        <div class="card-img-wrap">
          <img src={c.image} alt={c.name} class="card-img" loading="lazy" />
          <div class="card-img-overlay" style={`background: ${c.bg};`}></div>
          {!c.ready && <span class="card-badge">Coming soon</span>}
        </div>
        <div class="card-body">
          <div class="card-names">
            <span class="card-native">{c.native}</span>
            <span class="card-name">{c.name}</span>
          </div>
          <p class="card-tagline">{c.tagline}</p>
          <p class="card-desc">{c.description}</p>
          <div class="card-elements">
            {c.pillars.map(p => <span class="card-pill">{p}</span>)}
          </div>
          <div class="card-cta">
            {c.ready ? 'Explore culture →' : 'Coming soon'}
          </div>
        </div>
      </a>
    ))}
  </div>
</section>

<!-- ⑥ SEARCH OVERLAY -->
<div id="search-overlay" class="search-overlay">
  <div class="overlay-backdrop"></div>
  <div class="overlay-content">
    <div class="overlay-top">
      <div class="overlay-search-wrap">
        <svg class="search-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="8.5" cy="8.5" r="6"/><line x1="13" y1="13" x2="18" y2="18"/></svg>
        <input type="text" id="overlay-search-input" class="overlay-search-input" placeholder="Search for a culture..." autocomplete="off" />
        <button id="overlay-clear" class="overlay-clear" aria-label="Clear search">&times;</button>
      </div>
      <button id="overlay-close" class="overlay-close" aria-label="Close search">← Home</button>
    </div>
    <div id="overlay-grid" class="overlay-grid">
      {countries.map((c) => (
        <a href={c.path} class={`country-card${c.ready ? '' : ' coming-soon'}`} style={`--card-accent: ${c.accent};`} data-name={c.name.toLowerCase()} data-native={c.native.toLowerCase()}>
          <div class="card-img-wrap">
            <img src={c.image} alt={c.name} class="card-img" loading="lazy" />
            <div class="card-img-overlay" style={`background: ${c.bg};`}></div>
          </div>
          <div class="card-body">
            <div class="card-names">
              <span class="card-native">{c.native}</span>
              <span class="card-name">{c.name}</span>
            </div>
            <p class="card-tagline">{c.tagline}</p>
            <p class="card-desc">{c.description}</p>
            <div class="card-elements">
              {c.pillars.map(p => <span class="card-pill">{p}</span>)}
            </div>
            <div class="card-cta">
              {c.ready ? 'Explore culture →' : 'Coming soon'}
            </div>
          </div>
        </a>
      ))}
    </div>
    <p id="overlay-empty" class="overlay-empty">No cultures match your search.</p>
  </div>
</div>

<!-- ⑤ FOOTER -->
<footer class="footer">
  <div class="footer-inner">
    <span class="footer-logo">Spirit Mirror</span>
    <p class="footer-copy">Exploring cultures, one story at a time.</p>
  </div>
</footer>

<script>
  import gsap from 'gsap';

  const heroInput = document.getElementById('country-search') as HTMLInputElement;
  const heroClear = document.getElementById('search-clear') as HTMLButtonElement;

  const overlay = document.getElementById('search-overlay') as HTMLDivElement;
  const backdrop = overlay.querySelector('.overlay-backdrop') as HTMLDivElement;
  const overlayContent = overlay.querySelector('.overlay-content') as HTMLDivElement;
  const overlayInput = document.getElementById('overlay-search-input') as HTMLInputElement;
  const overlayClear = document.getElementById('overlay-clear') as HTMLButtonElement;
  const overlayClose = document.getElementById('overlay-close') as HTMLButtonElement;
  const overlayGrid = document.getElementById('overlay-grid') as HTMLDivElement;
  const overlayEmpty = document.getElementById('overlay-empty') as HTMLParagraphElement;

  let isOpen = false;
  let openTl: gsap.core.Timeline | null = null;

  function openOverlay() {
    if (isOpen) return;
    isOpen = true;
    document.body.style.overflow = 'hidden';
    history.pushState({ searchOverlay: true }, '');

    const cards = overlayGrid.querySelectorAll('.country-card');

    openTl = gsap.timeline({ defaults: { ease: 'power3.out' } });
    openTl
      .set(overlay, { display: 'flex' })
      .to(backdrop, { opacity: 1, duration: 0.35 })
      .fromTo(overlayContent, { y: 40, opacity: 0 }, { y: 0, opacity: 1, duration: 0.4 }, '-=0.2')
      .fromTo(cards, { y: 20, opacity: 0 }, { y: 0, opacity: 1, duration: 0.35, stagger: 0.06 }, '-=0.2');

    overlayInput.value = heroInput.value;
    overlayInput.focus();
    if (overlayInput.value.trim()) filterOverlay();
  }

  function closeOverlay() {
    if (!isOpen) return;
    isOpen = false;
    document.body.style.overflow = '';
    heroInput.blur();
    overlayInput.blur();

    const cards = overlayGrid.querySelectorAll('.country-card');
    const tl = gsap.timeline({
      defaults: { ease: 'power2.in' },
      onComplete: () => { gsap.set(overlay, { display: 'none' }); }
    });
    tl
      .to(cards, { y: -10, opacity: 0, duration: 0.2, stagger: 0.03 })
      .to(overlayContent, { y: -20, opacity: 0, duration: 0.25 }, '-=0.15')
      .to(backdrop, { opacity: 0, duration: 0.25 }, '-=0.25');
  }

  function filterOverlay() {
    const q = overlayInput.value.trim().toLowerCase();
    overlayClear.classList.toggle('visible', q.length > 0);

    const cards = overlayGrid.querySelectorAll<HTMLElement>('.country-card');
    let visible = 0;
    cards.forEach(card => {
      const name = (card.dataset.name ?? '') + ' ' + (card.dataset.native ?? '');
      const show = !q || name.includes(q);
      if (show) {
        visible++;
        gsap.to(card, { opacity: 1, scale: 1, duration: 0.25, display: 'flex' });
      } else {
        gsap.to(card, { opacity: 0, scale: 0.95, duration: 0.2, onComplete: () => { card.style.display = 'none'; } });
      }
    });

    overlayEmpty.style.display = visible === 0 && q ? 'block' : 'none';
    heroInput.value = overlayInput.value;
    heroClear.classList.toggle('visible', q.length > 0);
  }

  heroInput.addEventListener('focus', () => {
    if (!isOpen) openOverlay();
  });

  heroInput.addEventListener('input', () => {
    overlayInput.value = heroInput.value;
    if (!isOpen) openOverlay();
    filterOverlay();
  });

  overlayInput.addEventListener('input', filterOverlay);

  overlayClear.addEventListener('click', () => {
    overlayInput.value = '';
    filterOverlay();
    overlayInput.focus();
  });

  heroClear.addEventListener('click', () => {
    if (isOpen) {
      overlayInput.value = '';
      filterOverlay();
      overlayInput.focus();
    }
  });

  overlayClose.addEventListener('click', closeOverlay);

  backdrop.addEventListener('click', closeOverlay);

  window.addEventListener('popstate', () => {
    if (isOpen) closeOverlay();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) {
      history.back();
    }
  });

  gsap.set(overlay, { display: 'none' });
</script>

</Layout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,700;0,900;1,400&display=swap');

  *, *::before, *::after { box-sizing: border-box; }

  /* ── Tokens ─────────────────────────────────── */
  :root {
    --bg: #f5f8f4;
    --bg2: #edf3ed;
    --bg3: #e4ede4;
    --white: #ffffff;
    --muted: rgba(30,50,30,0.6);
    --border: rgba(0,60,0,0.1);
    --accent: #2d7a4a;
    --accent2: #c47a15;
    --text: #1a1a1a;
  }

  /* ── Base ───────────────────────────────────── */
  .hero, .countries, .themes, .why, .footer {
    font-family: 'Inter', sans-serif;
  }

  /* ── Hero ───────────────────────────────────── */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 100px 24px 32px;
    overflow: hidden;
    background: var(--bg);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.2;
  }
  .hero-orb-1 { width: 500px; height: 500px; background: #a5d6a7; top: -200px; left: -150px; }
  .hero-orb-2 { width: 350px; height: 350px; background: #c5cae9; top: -50px; right: -100px; }
  .hero-orb-3 { width: 400px; height: 250px; background: #ffe0b2; bottom: -100px; left: 30%; }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 900px;
  }

  .hero-h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 900;
    line-height: 1.15;
    color: #1a1a1a;
    margin: 0 0 12px;
    letter-spacing: -0.02em;
  }

  .hero-h1 em {
    font-style: italic;
    color: var(--accent);
  }

  .hero-sub {
    font-size: clamp(0.88rem, 1.5vw, 1rem);
    font-weight: 300;
    line-height: 1.6;
    color: rgba(30,50,30,0.65);
    max-width: 480px;
    margin: 0 auto 20px;
  }

  /* ── Section shared ─────────────────────────── */
  .section-header {
    text-align: center;
    margin-bottom: 56px;
  }

  .section-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 700;
    color: #1a1a1a;
    margin: 0 0 12px;
    letter-spacing: -0.01em;
  }

  .section-sub {
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--muted);
    max-width: 520px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* ── Cultures Strip ─────────────────────────── */
  .cultures-strip {
    background: var(--bg);
    padding: 12px 32px 40px;
    position: relative;
  }

  .search-container {
    max-width: 480px;
    margin: 0 auto;
  }

  .search-wrap {
    position: relative;
  }

  .search-icon {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    width: 18px;
    height: 18px;
    color: rgba(30,50,30,0.35);
    pointer-events: none;
  }

  .search-input {
    width: 100%;
    padding: 14px 40px 14px 46px;
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    color: #1a1a1a;
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: 100px;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    box-shadow: 0 1px 4px rgba(0,0,0,0.05);
  }

  .search-input::placeholder {
    color: rgba(30,50,30,0.35);
  }

  .search-input:focus {
    border-color: rgba(45,122,74,0.4);
    box-shadow: 0 0 0 3px rgba(45,122,74,0.1);
  }

  .search-clear {
    position: absolute;
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    font-size: 1.3rem;
    color: rgba(30,50,30,0.35);
    cursor: pointer;
    padding: 4px 10px;
    border-radius: 100px;
    display: none;
    transition: color 0.15s;
    line-height: 1;
  }

  .search-clear:hover {
    color: rgba(30,50,30,0.6);
  }

  .search-clear.visible {
    display: block;
  }

  .country-grid {
    display: flex;
    overflow-x: auto;
    gap: 20px;
    max-width: 1440px;
    margin: 0 auto;
    padding: 4px 40px 8px;
    scrollbar-width: none;
    mask-image: linear-gradient(to right, transparent, black 40px, black calc(100% - 40px), transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 40px, black calc(100% - 40px), transparent);
  }
  .country-grid::-webkit-scrollbar { display: none; }

  .country-card {
    flex: 0 0 300px;
    display: flex;
    flex-direction: column;
    border-radius: 16px;
    overflow: visible;
    text-decoration: none;
    background: #ffffff;
    border: 1px solid var(--border);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s;
    box-shadow: 0 1px 4px rgba(0,0,0,0.06);
  }

  .country-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    border-color: var(--card-accent, rgba(45,122,74,0.3));
  }

  .country-card.coming-soon {
    opacity: 0.6;
    pointer-events: none;
  }

  .card-img-wrap {
    position: relative;
    height: 160px;
    overflow: hidden;
    border-radius: 16px 16px 0 0;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .country-card:hover .card-img {
    transform: scale(1.05);
  }

  .card-img-overlay {
    position: absolute;
    inset: 0;
    opacity: 0.35;
    mix-blend-mode: multiply;
  }

  .card-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: rgba(255,255,255,0.9);
    color: rgba(30,50,30,0.8);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 100px;
    border: 1px solid rgba(0,60,0,0.1);
  }

  .card-body {
    padding: 20px 22px 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-names {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 6px;
  }

  .card-native {
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem;
    font-weight: 700;
    color: #1a1a1a;
    line-height: 1;
  }

  .card-name {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .card-tagline {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--card-accent, #2d7a4a);
    margin: 0 0 10px;
    text-transform: uppercase;
  }

  .card-desc {
    font-size: 0.875rem;
    line-height: 1.65;
    color: rgba(30,50,30,0.6);
    margin: 0 0 16px;
    flex: 1;
  }

  .card-elements {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 16px;
  }

  .card-pill {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: rgba(30,50,30,0.55);
    background: rgba(45,122,74,0.06);
    border: 1px solid rgba(45,122,74,0.15);
    border-radius: 100px;
    padding: 3px 10px;
  }

  .card-cta {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--card-accent, #2d7a4a);
    letter-spacing: 0.03em;
    transition: gap 0.2s;
  }

  /* ── Footer ─────────────────────────────────── */
  .footer {
    background: #edf3ed;
    padding: 40px 24px;
    border-top: 1px solid var(--border);
    margin-top: auto;
  }

  .footer-inner {
    max-width: 1440px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
  }

  .footer-logo {
    font-family: 'Playfair Display', serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: #1a5c2a;
    letter-spacing: 0.04em;
  }

  .footer-copy {
    font-size: 0.78rem;
    color: rgba(30,50,30,0.4);
    margin: 0;
  }

  /* ── Search Overlay ─────────────────────────── */
  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: 300;
    display: none;
    flex-direction: column;
    font-family: 'Inter', sans-serif;
  }

